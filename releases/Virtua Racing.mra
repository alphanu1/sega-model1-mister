<misterromdescription>
    <name>Virtua Racing</name>
    <setname>vr</setname>
    <rbf>Model1</rbf>
    <mameversion>0261</mameversion>
    <year>1992</year>
    <manufacturer>Sega</manufacturer>
    <category>Driving</category>

    <!--
      Generated by tools/gen_mra.py from MAME's model1.cpp. Do not hand-edit:
      regenerate, so the layout keeps one source.

      m1_rom_loader does no base-address arithmetic, so this file owns the ROM
      layout completely. A misplaced region does not fail at load - it fails as
      a checksum error much later, looking like a CPU bug.

      tools/verify_mra.py diffs this against build_rom_image.py's
      independently written packing, so the layout has a second source.

      The V60 address space is sparse; rtl/io/m1_decode.sv maps it packed:
        V60 0x200000-0x2fffff  ROMX, the program     -> stream 0x000000
        V60 0xf80000-0xffffff  ROM0, the boot vector -> stream 0x100000
        V60 0x100000-0x1fffff  banked data, +bank    -> stream 0x180000

      The TGP microcode goes on index 1 and its data ROM and sincos tables
      are appended to this stream. Not sent yet: the polygon ROMs and the
      sound board. Those blocks do not exist in the core, so sending them would
      only slow the load. They belong here as M2 and M4 land.
    -->
    <rom index="0" zip="vr.zip" md5="none">
        <!-- stream 0x000000, ROM_LOAD16_BYTE -->
        <interleave output="16">
            <part name="epr-14882.14" map="01"/>
            <part name="epr-14883.15" map="10"/>
        </interleave>
        <!-- stream 0x100000: 262144 bytes unpopulated -->
        <part repeat="262144">FF</part>
        <!-- stream 0x140000 -->
        <part name="epr-14878a.4"/>
        <!-- stream 0x160000 -->
        <part name="epr-14879a.5"/>
        <!-- stream 0x180000, ROM_LOAD16_BYTE -->
        <interleave output="16">
            <part name="mpr-14880.6" map="01"/>
            <part name="mpr-14881.7" map="10"/>
        </interleave>
        <!-- stream 0x280000, ROM_LOAD16_BYTE -->
        <interleave output="16">
            <part name="mpr-14884.8" map="01"/>
            <part name="mpr-14885.9" map="10"/>
        </interleave>
        <!-- stream 0x380000, ROM_LOAD16_BYTE -->
        <interleave output="16">
            <part name="mpr-14886.10" map="01"/>
            <part name="mpr-14887.11" map="10"/>
        </interleave>
        <!-- stream 0x480000, ROM_LOAD16_BYTE -->
        <interleave output="16">
            <part name="mpr-14888.12" map="01"/>
            <part name="mpr-14889.13" map="10"/>
        </interleave>
        <!-- stream 0x580000: 524288 bytes unpopulated -->
        <part repeat="524288">FF</part>
        <!-- stream 0x600000: the coprocessor's DATA ROM, 2 MB.
             MAME's copro_data. The TGP reads it through IO 0x8000-0xffff
             and it is read BEFORE any math unit, so without it the
             coprocessor stalls at microcode 0x49, never drains its command
             FIFO, and a full FIFO halts the V60 — a screen that tears down
             and rebuilds every 0.45 s. COPRO_DAT_BASE in m1_integrated.sv.
             ROM_LOAD32_BYTE x4 is a four-way byte interleave. -->
        <interleave output="32">
            <part name="mpr-14898.39" map="0001"/>
            <part name="mpr-14899.40" map="0010"/>
            <part name="mpr-14900.41" map="0100"/>
            <part name="mpr-14901.42" map="1000"/>
        </interleave>
        <!-- stream 0x800000: the sincos tables, 256 KB.
             MAME's copro_tables, from MODEL1_CPU_BOARD. COPRO_TBL_BASE in
             m1_integrated.sv. ROM_LOAD32_WORD x2 is a two-way 16-bit
             interleave into the same 32-bit words.

             MAME's other_data — opr-14744..14747, the 1/x and 1/sqrt
             tables — is deliberately absent: this design computes those in
             fp_div rather than reading them, so there is no port for them
             and the files are not in the ROM set. -->
        <interleave output="32">
            <part name="opr14742.bin" map="0021"/>
            <part name="opr14743.bin" map="2100"/>
        </interleave>
        <!-- stream 0x840000: the polygon model ROMs, 16 MB.
             MAME's `polygons` region. Pairs of ROM_LOAD32_WORD halves,
             each pair 4 MB apart, exactly as the sincos tables above but
             4 times over.

             This region was ABSENT until 2026-08-30 and nothing noticed,
             because nothing read it: with no rasterizer a missing 16 MB
             looks identical to a working core. The coprocessor data ROM
             went missing the same way and cost two sessions. -->
        <interleave output="32">
            <part name="mpr-14890.26" map="0021"/>
            <part name="mpr-14891.27" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-14892.28" map="0021"/>
            <part name="mpr-14893.29" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-14894.30" map="0021"/>
            <part name="mpr-14895.31" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-14896.32" map="0021"/>
            <part name="mpr-14897.33" map="2100"/>
        </interleave>
    </rom>

    <!-- Coprocessor microcode, on its own download index.
         m1_rom_loader routes index 1 to the TGP's program RAM rather than to
         SDRAM, so this needs no offset inside the main stream: putting it at the
         loader's old byte offset would have meant padding 25 MB of filler
         through the HPS to deliver 8 KB. 2048 words of 32 bits, little-endian,
         which is exactly the file. -->
    <rom index="1" zip="vr.zip|vr.7z" md5="none">
        <part name="315-5573.bin"/>
    </rom>

    <!-- The I/O board Z80 firmware, from MAME's model1io BIOS set.
         REQUIRED: the core runs the real Z80 and there is no
         behavioural fallback. MAME will not start this game without
         the same file, so a complete romset already has it. -->
    <rom index="2" zip="model1io.zip|daytona93.zip" md5="none">
        <part name="epr-14869.25"/>
    </rom>

    <!-- The I/O board's 93C46 settings EEPROM, 128 bytes, from the GAME set
         rather than the model1io BIOS set. Its first word is the "SEGA"
         signature the V60 checks at FE078E before deciding the board has been
         configured; without it the firmware publishes an identity block that
         fails that check and the game takes its uninitialised-board branch,
         which walks a much shorter display list. Its own index because
         m1_ioz80 preloads its array from SDRAM before releasing the Z80. -->
    <rom index="3" zip="vr.zip|vr.7z" md5="none">
        <part name="93c45.bin"/>
    </rom>

    <nvram index="255" size="256"/>

    <buttons names="Accelerate,Brake,Shift Up,Shift Down,VR1,VR2,VR3,VR4,Start,Coin,Service,Test,Coin 2" default="R2,L2,R1,L1,A,B,X,Y,Start,Select"/>
</misterromdescription>
