/obj_*/
/sim/**/obj_*/
*.vcd
*.fst
*.fst.hier
*.wlf

# ----------------------------------------------------------------- yosys
*.json.yosys
/yosys.log
# abc writes its command history into the working directory on every
# `make area` run, which for this Makefile is the repo root.
/abc.history
*.blif
*.edif

# ---------------------------------------------------------------- quartus
# THE WHOLE DIRECTORY, by Ben's decision on 2026-09-07. It is NOT generated
# output -- it holds four hand-written build sources -- so this is a choice to
# keep them off GitHub rather than a cleanup of build junk:
#
#   spike.qsf.in       the project template Makefile:987 expands for
#                      `make quartus MOD=<module>`
#   spike.sdc          that project's timing constraints, Makefile:988
#   report.sh          the ALM / M10K / DSP / Fmax report parser
#   report_timing.tcl  `make quartus_paths`
#
# THE CONSEQUENCE, recorded so it is not rediscovered: a fresh clone has no
# `make quartus` and no `make quartus_paths`. Those are the targets that settle
# the resource gates, so anyone starting from a clone must restore these four
# files first. `make rbf` is NOT affected -- it stages its own project through
# tools/mister_project.sh, which is still tracked.
/quartus/
# Verilator build trees from tools/run_v60_tests.sh. Anchored with a leading
# slash so it means the top-level directory only, and checked for as a whole
# line rather than a substring — an earlier check tested for "/build/" being
# present, which "/quartus/build/" already satisfies, so the rule was silently
# never added and the logs got committed.
/build/
db/
incremental_db/
output_files/
greybox_tmp/
simulation/
timing/
.qsys_edit/
qdb/
*.qws
*.rpt
*.summary
*.smsg
*.pin
*.done
*.jdi
*.sld
*.qar
*.qarlog
*.sopcinfo
*.bak
*.orig
*.rej

# Bitstreams and programming files.
*.sof
*.pof
*.rbf
*.jic
*.map
*.fit
*.sta
*.asm

# MiSTer release output.
/releases/

# --------------------------------------------------------------- toolchain
/tools/**/__pycache__/
*.pyc

# Quartus installer: BOTH the downloaded archive and the unpacked tree. Several
# GB each, and Altera-licensed — redistributing it is not permitted, so neither
# may ever be committed.
#
# This is not hypothetical. A `git add -A` run while a 1.9 GB partial download
# sat in tools/ committed 1.39 GB of it, taking .git from ~1 MB to 3.6 GB. It
# was caught before pushing, but only just. Prefer `git add <path>` over -A in
# this repo.
#
# No trailing slash on the directory rule: a directory-only pattern cannot match
# a path that does not exist yet, and install-quartus17.sh checks the path is
# ignored BEFORE creating it — with a slash that guard fires on every clean run.
/tools/quartus-unpack

# The archive itself, however it is named, plus in-progress browser downloads.
# Chrome writes "Unconfirmed NNNNN.crdownload" with a space in the name, which
# no *.tar pattern would ever catch.
/tools/*.tar
/tools/*.tar.*
/tools/Quartus*
/tools/QuartusLiteSetup*
/tools/*.qdz
*.crdownload
*.part
*.download
*.partial

# --------------------------------------------------------------------- roms
# Never commit ROM images or anything derived from them.
*.zip
*.7z
/roms/
/rom/

# ------------------------------------------------------------------- editor
# Shared project settings are committed; everything else under .vscode/ is not.
# Note the directory itself must not be excluded — git will not re-include a
# file underneath an excluded directory, so this has to be `.vscode/*`.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local working instructions, kept on disk but not published.
/CLAUDE.md

# ROM-derived images. Hard rule 2: nothing derived from ROMs is committed.
/build/rom/
*.hex

# The confirmed-working .rbf is kept for restore but not committed - it is a
# 4.6 MB build artefact. Its md5 and the README that says how to rebuild it ARE
# committed, so the binary can always be reproduced from 61e383e.
known_good/*.rbf
